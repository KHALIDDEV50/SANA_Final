# Copy to .env ON THE SERVER and fill in the real values. Never commit .env.

# Your domain, pointing to the EC2 server's IP address (Caddy uses it for HTTPS)
DOMAIN=sana.example.com

# RDS MySQL: the endpoint is shown in the RDS console
DB_URL=jdbc:mysql://YOUR-RDS-ENDPOINT:3306/SANA?createDatabaseIfNotExist=true
DB_USERNAME=admin
DB_PASSWORD=

# n8n (the same values you use locally)
N8N_AI_WEBHOOK_URL=
N8N_AI_WEBHOOK_KEY=
N8N_AI_CALLBACK_KEY=

# Moodboard images: free key from https://pixabay.com/api/docs/ (optional; without it Pixabay is skipped)
PIXABAY_API_KEY=

# Billing (Moyasar TEST mode). Keep SANA_BILLING_ENABLED=false to leave billing off.
SANA_BILLING_ENABLED=false
SANA_BILLING_TEST_MODE=true
# Starts with sk_test_ (Moyasar dashboard). Never commit it.
MOYASAR_SECRET_KEY=
# The site's address, e.g. https://13-63-96-176.sslip.io (no path, no trailing /)
SANA_PUBLIC_BASE_URL=
SANA_FRONTEND_BASE_URL=
