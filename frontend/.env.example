# SANA frontend setup. Copy this file to frontend/.env to change modes.
# DEMO keeps data in browser localStorage. It does not call Spring Boot.
VITE_SANA_MODE=demo

# To connect existing Spring Boot controllers during local development:
# 1. Change VITE_SANA_MODE to api
# 2. Keep API URL empty so Vite proxies /api to localhost:8080 (no CORS setup needed).
# VITE_SANA_MODE=api
# VITE_SANA_API_URL=

# In API mode users log in on the login screen (HTTP Basic, email + password).
# The backend only lets each user reach their own projects.
